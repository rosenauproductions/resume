# Pipeline password gate
JOB_TRACKER_SECRET=

# Neon Postgres (vercel env pull after Marketplace install)
DATABASE_URL=

# Optional Drive JSON import
JOB_TRACKER_DRIVE_FILE_ID=
# JOB_TRACKER_SEED_URL=

# Visit notifications (ntfy) — dual-track with DB visit log
# Topic can also be set in Pipeline → Settings (DB overrides this when set).
VISIT_NOTIFY_NTFY_TOPIC=
# VISIT_NOTIFY_NTFY_TOKEN=
# VISIT_NOTIFY_DISCORD_WEBHOOK=

# Lead email notifications (Resend — https://resend.com, free tier is plenty).
# Fires only when a website visitor submits the contact form / becomes a lead —
# not on every page visit. Get an API key from the Resend dashboard.
# RESEND_API_KEY=
# Defaults to rosenauproductions@gmail.com if unset.
# VISIT_NOTIFY_EMAIL_TO=rosenauproductions@gmail.com
# Sandbox sender that works with no domain verification (deliverability may be
# limited to your own Resend account email until you verify a real domain).
# VISIT_NOTIFY_EMAIL_FROM=Resume Leads <onboarding@resend.dev>

# Comma-separated browser device IDs that skip ntfy/Discord (still logged to Neon as ignored).
# Copy yours from /pipeline → Visits (“This browser’s device ID”). Stored in localStorage as resume-device-id.
# VISIT_IGNORE_DEVICE_IDS=

# Optional legacy Blob fallback
# BLOB_READ_WRITE_TOKEN=

# Optional AI via Vercel AI Gateway (AI SDK).
# On Vercel, OIDC (VERCEL_OIDC_TOKEN) may work without a key.
# Locally set AI_GATEWAY_API_KEY from the Vercel AI Gateway dashboard.
# Powers: JD ingest + public resume chatbot. No separate Gemini/OpenAI key needed.
# AI_GATEWAY_API_KEY=
# PIPELINE_INGEST_MODEL=openai/gpt-4.1-nano
# RESUME_CHAT_MODEL=google/gemini-2.5-flash

# Web Push (VAPID) — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rosenauproductions@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
